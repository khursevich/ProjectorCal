#!/usr/bin/env python3
"""spotread stub for development without a meter.
Prints the prompt and on any key (except q/Esc) outputs a line 'Result is XYZ: X Y Z'.
Values are read line by line from the STUB_SEQ file (default /tmp/stub_seq), line format: "X Y Z".
The last line repeats. Needs a tty (run under a pty/pexpect).
Usage: PATH=<folder with this file>:$PATH ; chmod +x fake_spotread"""
import os, sys, tty, termios
seq_path = os.environ.get("STUB_SEQ", "/tmp/stub_seq")
if os.path.exists(seq_path):
    seq = [l.split() for l in open(seq_path).read().strip().splitlines()]
else:
    seq = [["47.5", "50.0", "54.4"]]
fd = sys.stdin.fileno(); old = termios.tcgetattr(fd); tty.setcbreak(fd)
def prompt():
    sys.stdout.write("\nPlace instrument on spot to be measured,\nand then hit any key to measure it.\nHit ESC or Q to exit\n"); sys.stdout.flush()
prompt(); i = 0
try:
    while True:
        c = sys.stdin.read(1)
        if c in ("q", "Q", "\x1b"): break
        v = seq[min(i, len(seq) - 1)]; i += 1
        sys.stdout.write(f" Result is XYZ: {v[0]} {v[1]} {v[2]}, D50 Lab is 50.0 0.0 0.0\n"); prompt()
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, old)
