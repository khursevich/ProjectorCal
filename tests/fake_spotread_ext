#!/usr/bin/env python3
"""Extended spotread stub for integration tests (mimics the Argyll format).
Environment variables:
  STUB_SEQ       file with "X Y Z" lines (the last one repeats)
  FAKE_CALIB=1   ask for the calibration position at start
  FAKE_NOINST=1  exit at once with a "no instrument" error
  FAKE_HANG_AT=n hang on the n-th reading (no output)
  FAKE_EXIT_AT=n exit on the n-th reading (as on USB disconnect)
  FAKE_FAIL_AT=n the n-th reading fails (message + prompt again)
  FAKE_DELAY=s   reading delay, s
  FAKE_PIDFILE   write own pid
"""
import os, sys, time, tty, termios
if os.environ.get("FAKE_PIDFILE"):
    open(os.environ["FAKE_PIDFILE"], "w").write(str(os.getpid()))
if os.environ.get("FAKE_NOINST"):
    sys.stdout.write("\nSpotread: Error - No instrument found or failed to open instrument\n"
                     "Diagnostic: Instrument Access Failed\n"); sys.stdout.flush(); sys.exit(1)
seq_path = os.environ.get("STUB_SEQ", "")
seq = [l.split() for l in open(seq_path).read().strip().splitlines()] if seq_path and os.path.exists(seq_path) \
    else [["47.5235", "50.0", "54.4415"]]
hang = int(os.environ.get("FAKE_HANG_AT", "0")); ex = int(os.environ.get("FAKE_EXIT_AT", "0"))
fail = int(os.environ.get("FAKE_FAIL_AT", "0")); delay = float(os.environ.get("FAKE_DELAY", "0.05"))
fd = sys.stdin.fileno(); old = termios.tcgetattr(fd); tty.setcbreak(fd)
def w(s):
    sys.stdout.write(s); sys.stdout.flush()
def prompt():
    w("\nPlace instrument on spot to be measured,\nand then hit 'r' to set reference, 'k' to do a calibration,\n"
      "Hit ESC or Q to exit, instrument switch or any other key to take a reading: ")
try:
    w("Setting up the instrument\n")
    if os.environ.get("FAKE_CALIB"):
        w("\nSet instrument sensor to calibration position,\n(and then hit any key to continue,\n or hit Esc or Q to abort): ")
        c = sys.stdin.read(1)
        if c in ("q", "Q", "\x1b"):
            sys.exit(0)
        w("\nCalibration complete\n")
    prompt(); i = 0
    while True:
        c = sys.stdin.read(1)
        if c in ("q", "Q", "\x1b"):
            break
        i += 1
        if i == hang:
            time.sleep(3600)
        if i == ex:
            w("\nSpot read failed due to the instrument being disconnected\n"); sys.exit(1)
        time.sleep(delay)
        if i == fail:
            w("\nSpot read failed due to misread (Instrument read error)\n"); prompt(); continue
        v = seq[min(i - 1, len(seq) - 1)]
        w("\n Result is XYZ: %s %s %s, Yxy: %s 0.3127 0.3290\n" % (v[0], v[1], v[2], v[1])); prompt()
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, old)
